<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Samples</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Equality.fs" />
        <Compile Include="Arithmetic.fs" />
        <Compile Include="Collection.fs" />
        <Compile Include="RelationalBoundary.fs" />
        <Compile Include="RelationalReversal.fs" />
        <Compile Include="Boolean.fs" />
        <Compile Include="Conditional.fs" />
        <Compile Include="Option.fs" />
        <Compile Include="ControlFlow.fs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="FSharp.Core" Version="10.1.402" />
    </ItemGroup>

</Project>
