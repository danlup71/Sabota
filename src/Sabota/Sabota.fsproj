<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Sabota</RootNamespace>
        <PublishSingleFile>true</PublishSingleFile>
        <UseAppHost>true</UseAppHost>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Args.fs" />
        <Compile Include="MutationTypes.fs" />
        <Compile Include="MutationCandidates.fs" />
        <Compile Include="MutationDefinitions.fs" />
        <Compile Include="Visitor.fs" />
        <Compile Include="Report.fs" />
        <Compile Include="Files.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FSharp.Compiler.Service" Version="43.12.402" />
    </ItemGroup>

</Project>
