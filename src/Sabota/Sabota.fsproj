<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Sabota</RootNamespace>
        <PublishSingleFile>true</PublishSingleFile>
        <UseAppHost>true</UseAppHost>
        <Version>0.1.0</Version>
        <Title>Sabota</Title>
        <Authors>Daniele Luppi</Authors>
        <Description>Mutation testing for F# using AST discovery and source-text mutations.</Description>
        <Copyright>Copyright (c) 2026 Daniele Luppi</Copyright>
        <RepositoryUrl>https://github.com/danlup71/Sabota</RepositoryUrl>
        <PackageTags>fsharp; mutation-testing; testing; dotnet; cli; code-quality</PackageTags>
        <Company>Daniele Luppi</Company>
        <AssemblyVersion>0.1.0</AssemblyVersion>
    </PropertyGroup>
    
    <ItemGroup>
        <Content Include="sabota_config.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="MutationTypes.fs" />
        <Compile Include="MutationCandidates.fs" />
        <Compile Include="MutationDefinitions.fs" />
        <Compile Include="MultiError.fs" />
        <Compile Include="Config.fs" />
        <Compile Include="Args.fs" />
        <Compile Include="Visitor.fs" />
        <Compile Include="Mutator.fs" />
        <Compile Include="Files.fs" />
        <Compile Include="Report.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    
    
    <ItemGroup>
      <PackageReference Include="FSharp.Compiler.Service" Version="43.12.402" />
      <PackageReference Update="FSharp.Core" Version="10.1.402" />
    </ItemGroup>

</Project>
